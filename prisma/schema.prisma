// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== ENUMS ==========

enum UserRole {
  ADMIN
  CUSTOMER
  STAFF
  OWNER
}

enum OrderStatus {
  PLACED
  ACCEPTED
  REJECTED
  PREPARING
  READY
  DELIVERED
}

enum DeliveryType {
  PICKUP
  DELIVERY
  DINEIN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum StaffRole {
  CHEF
  WAITER
  MANAGER
  CASHIER
  DELIVERY
  CLEANER
  OTHER
}

enum SalaryPeriod {
  HOURLY
  WEEKLY
  MONTHLY
}

enum ExpenseCategory {
  SALARY
  GROCERIES
  UTILITIES
  RENT
  MAINTENANCE
  EQUIPMENT
  MARKETING
  INSURANCE
  TRAVEL
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  STRIPE
  OTHER
}

enum NotificationType {
  ORDER
  RESERVATION
  PROMO
  SYSTEM
}

// ========== MODELS ==========

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  role      UserRole  @default(CUSTOMER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  active Boolean   @default(true)
  // Relation fields (inverse only)
  customer   Customer?   @relation("UserCustomer") // ← no fields/references
  restaurant Restaurant? @relation("UserRestaurant")
  createdOrders Order[]  @relation("OrderCreatedBy")
  staff        Staff?
  passwordResetToken PasswordResetToken?
  notifications      Notification[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String?
  phone     String?
  email     String?  @unique
  address   String?
  postcode  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  totalSpent Decimal @default(0) @db.Decimal(12, 2)
  orderCount Int     @default(0)
  isGuest    Boolean @default(false)

  userId Int?  @unique
  user   User? @relation("UserCustomer", fields: [userId], references: [id], onDelete: SetNull)

  orders       Order[]
  reviews      Review[]
  reservations Reservation[] @relation("CustomerReservations")
  usageHistory       UserPromoUsage[]

  @@index([email])
  @@index([createdAt])
  @@index([deletedAt])
}


model Restaurant {
  id             Int      @id @default(autoincrement())
  name           String
  address        String?
  email          String   @unique
  logoPath       String?
  deliveryTime   String?
  collectionTime String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId Int?  @unique
  user   User? @relation("UserRestaurant", fields: [userId], references: [id], onDelete: SetNull)

  foods           Food[]
  orders          Order[]
  categories      Category[]
  deliveryZones   DeliveryZone[]
  reviews         Review[]
  promoCodes      PromoCode[]
  staff           Staff[]
  expenses        Expense[]
  tables          Table[]
  reservations    Reservation[]

  @@index([id])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  image     String?
  createdAt DateTime @default(now())

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  foods        Food[]
  available       Boolean   @default(true)

  @@unique([name, restaurantId])
  @@index([restaurantId])
}

model Food {
  id              Int       @id @default(autoincrement())
  name            String
  description     String?
  price           Decimal   @db.Decimal(10, 2)
  image           String?
  available       Boolean   @default(true)
  prepTimeMinutes Int       @default(15)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  options FoodOption[]
  items   OrderItem[]

  @@unique([name, restaurantId])
  @@index([categoryId])
  @@index([restaurantId])
  @@index([available])
  @@index([deletedAt])
}

model FoodOption {
  id         Int         @id @default(autoincrement())
  name       String
  price      Decimal     @db.Decimal(10, 2)
  foodId     Int
  food       Food        @relation(fields: [foodId], references: [id])
  orderItems OrderItem[]

  @@index([foodId])
}

model Order {
  id                   Int            @id @default(autoincrement())
  totalAmount          Decimal        @db.Decimal(10, 2)
  finalAmount          Decimal?       @db.Decimal(10, 2)
  discountAmount       Decimal?       @default(0) @db.Decimal(10, 2)

  promoCodeId Int?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])

  paymentStatus        PaymentStatus  @default(PENDING)
  paymentMethod        PaymentMethod?
  status               OrderStatus    @default(PLACED)
  deliveryType         DeliveryType
  timeSlot             String?
  orderNote            String?
  address              String?
  postcode             String?
  expectedDeliveryTime String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  items OrderItem[]

  createdById Int?
  createdBy   User? @relation("OrderCreatedBy", fields: [createdById], references: [id])

  currentTableFor Table? @relation("CurrentOrder")

  review Review?

  stripeSessionId     String? @unique
  stripeCustomerId    String?
  stripePaymentIntent String? @unique

  notifications     Notification[]
  promoUsageRecords UserPromoUsage[]

  

  @@index([customerId])
  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
  @@index([status, restaurantId])
  @@index([stripeSessionId])
}

model OrderItem {
  id       Int      @id @default(autoincrement())
  quantity Int
  price    Decimal  @db.Decimal(10, 2)
  notes    String?
  addedAt  DateTime @default(now())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  foodId Int
  food   Food @relation(fields: [foodId], references: [id])

  foodOptionId Int?
  foodOption   FoodOption? @relation(fields: [foodOptionId], references: [id])

  @@index([orderId])
  @@index([foodId])
  @@index([addedAt])
}

model DeliveryZone {
  id           Int        @id @default(autoincrement())
  postcode     String
  deliveryFee  Decimal    @db.Decimal(10, 2)
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([postcode, restaurantId])
  @@index([postcode])
  @@index([restaurantId])
}

model Table {
  id        Int         @id @default(autoincrement())
  number    String      
  capacity  Int         @default(4)
  location  String?
  status    TableStatus @default(AVAILABLE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  currentOrderId Int?   @unique
  currentOrder   Order? @relation("CurrentOrder", fields: [currentOrderId], references: [id])

  reservations ReservationTable[]

  @@unique([number, restaurantId])

  @@index([restaurantId])
  @@index([status])
  @@index([currentOrderId])
  @@index([deletedAt])
}

model Reservation {
  id        Int               @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  guests    Int
  startsAt  DateTime 
  duration  Int               @default(90)
  notes     String?
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  deletedAt DateTime?

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  customerId Int?
  customer   Customer? @relation("CustomerReservations", fields: [customerId], references: [id])

  tables ReservationTable[]

  @@index([restaurantId])
  @@index([startsAt])
  @@index([status])
  @@index([customerId])
  @@index([deletedAt])
}

model ReservationTable {
  id            Int         @id @default(autoincrement())
  reservationId Int
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  tableId       Int
  table         Table       @relation(fields: [tableId], references: [id])
  assignedAt    DateTime    @default(now())

  @@unique([reservationId, tableId])
  @@index([reservationId])
  @@index([tableId])
}

model Notification {
  id          Int              @id @default(autoincrement())
  message     String
  type        NotificationType
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  redirectUrl String?

  userId Int?
user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id])

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([customerId])
  @@index([restaurantId])
  @@index([createdAt])
}

model PromoCode {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  discountPercent Decimal?  @db.Decimal(5, 2)
  discountAmount  Decimal?  @db.Decimal(10, 2)
  minOrderAmount  Decimal?  @db.Decimal(10, 2)
  maxUses         Int?
  maxUsesPerUser  Int?
  currentUses     Int       @default(0)
  expiresAt       DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurantId Int?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])

  usageRecords UserPromoUsage[]
  orders       Order[]  // ✅ added opposite side

  @@index([code])
  @@index([active])
  @@index([restaurantId])
  @@index([expiresAt])
}

model UserPromoUsage {
  id           Int       @id @default(autoincrement())
  customerId   Int
  customer     Customer  @relation(fields: [customerId], references: [id])
  promoCodeId  Int
  promoCode    PromoCode @relation(fields: [promoCodeId], references: [id])
  orderId      Int?
  order        Order?    @relation(fields: [orderId], references: [id])
  usedAt       DateTime  @default(now())

  @@index([customerId])
  @@index([promoCodeId])
  @@index([customerId, promoCodeId])
  @@index([usedAt])
}


model Staff {
  id           Int          @id @default(autoincrement())
  name         String
  role         StaffRole
  email        String?      @unique
  phone        String?
  hireDate     DateTime     @default(now())
  salary       Decimal?     @db.Decimal(10, 2)
  hourlyRate   Decimal?     @db.Decimal(10, 2)
  salaryPeriod SalaryPeriod @default(HOURLY)
  active       Boolean      @default(true)
  notes        String?
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  expenses Expense[]
  userId   Int?      @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([role])
  @@index([email])
  @@index([deletedAt])
}

model Expense {
  id          Int             @id @default(autoincrement())
  description String?
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime        @default(now())
  receiptPath String?
  recurring   Boolean         @default(false)
  notes       String?
  updatedAt   DateTime        @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  staffId Int?
  staff   Staff? @relation(fields: [staffId], references: [id])

  @@index([category])
  @@index([date])
  @@index([staffId])
  @@index([category, date])
  @@index([restaurantId])
}
